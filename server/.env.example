# Copy to .env locally. Never commit real secrets.
NODE_ENV=development
PORT=3000
# Comma-separated exact frontend origins. Required in production.
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
# Set true only for a disposable local demo. Production removes built-in demo accounts.
DHWANI_KEEP_DEMO_ACCOUNTS=false

# Optional durable storage paths. Point these at persistent mounted storage in production.
# DHWANI_DATA_FILE=/var/lib/dhwani/data.json
# DHWANI_BACKUP_DIR=/var/lib/dhwani/backups
